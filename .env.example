# These values are included in the browser bundle. Use only public credentials.
# Use the same Supabase project and publishable key as the backend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend origin only: studyApi.ts already includes /api in request paths.
VITE_BACKEND_URL=http://localhost:3000
