# These values are included in the browser bundle. Use only public credentials.
# Use the same Supabase project and publishable key as the backend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend origin only: studyApi.ts already includes /api in request paths.
VITE_BACKEND_URL=http://localhost:3000

# Public Spotify application ID, never a Client Secret.
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match the Spotify app registration and this app's origin.
# Open the frontend at 127.0.0.1 for local Spotify authorization, not localhost.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback
